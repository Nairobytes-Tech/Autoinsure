# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-in-production
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://autoinsure:autoinsure_secret@db:5432/autoinsure
DB_NAME=autoinsure
DB_USER=autoinsure
DB_PASSWORD=autoinsure_secret
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# S3 Storage
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_STORAGE_BUCKET_NAME=autoinsure-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:4566

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
AWS_SES_REGION_NAME=us-east-1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# MFA
MFA_ISSUER_NAME=AutoInsure Connect
